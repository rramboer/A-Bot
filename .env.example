# Required. Bot token from the Discord Developer Portal (your application -> Bot -> Token).
DISCORD_TOKEN=

# Optional. Message ID of the message users react to for reaction roles
# (🖥️ grants the Student role, 🎓 grants the Student Alum role).
# If ROLE_MESSAGE_ID is unset, reaction roles are disabled and a warning is logged at
# startup. ROLE_MESSAGE_CHANNEL is only used to prefetch that message at startup so
# existing reactions resolve quickly — the feature still works without it.
ROLE_MESSAGE_CHANNEL=
ROLE_MESSAGE_ID=

# Optional. Role IDs granted by the reaction-role message. Defaults are the roles of the
# original EECS 370 server — override them when self-hosting.
STUDENT_ROLE_ID=
STUDENT_ALUM_ROLE_ID=

# Optional. The channel /invite creates invite links for, and the static invite returned
# when /invite is used without a use count. Defaults target the original EECS 370 server —
# override them when self-hosting.
INVITE_CHANNEL_ID=
STATIC_INVITE_URL=

# Optional. Filesystem path for the SQLite database. Defaults to db/casino.db.
DB_PATH=
