{
    "name": "a-bot",
    "version": "1.9.9",
    "description": "Discord Bot",
    "private": true,
    "type": "module",
    "author": "Ryan Ramboer",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/rramboer/A-Bot.git"
    },
    "engines": {
        "node": ">=24"
    },
    "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f",
    "scripts": {
        "dev": "tsx watch --env-file=.env src/index.ts",
        "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
        "start": "node --env-file=.env dist/index.js",
        "prod": "yarn build && yarn start",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "tsx --test \"test/**/*.test.ts\"",
        "db:reset": "node -e \"for (const f of ['db/casino.db','db/casino.db-wal','db/casino.db-shm']) fs.rmSync(f,{force:true}); console.log('Database reset.')\""
    },
    "dependencies": {
        "better-sqlite3": "^13.0.3",
        "discord.js": "^14.27.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/better-sqlite3": "^9.6.0",
        "@types/node": "^24",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.9.10",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.0"
    }
}
